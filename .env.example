# ── Required ──────────────────────────────────────────────────────────
# Local MySQL. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If your password contains @ : / ? # or %, URL-encode it (@ -> %40).
DATABASE_URL="mysql://root:Sanju1984@localhost:3306/globetrotter_db"

PORT=5000
NODE_ENV=development

# Must be 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_32plus_character_random_secret
JWT_EXPIRES_IN=7d

# Where the React app runs. Leave unset to allow any origin (fine locally).
CORS_ORIGIN=http://localhost:5173

# ── Optional: email (OTP delivery) ────────────────────────────────────
# Leave SMTP_USER empty and OTP codes are printed to the backend terminal
# instead of being emailed — which is all you need for local development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Optional: AI + live data providers ────────────────────────────────
# Without these, flight/hotel/transport search, live events and the AI
# auto-planner return a clear "not configured" message instead of results.
OPENROUTER_API_KEY=

# Which OpenRouter model the AI features use. Defaults to openai/gpt-4o-mini,
# which is PAID — if the account runs out of credit, switch to a free one:
#   OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=
SERPAPI_KEY=
TICKETMASTER_API_KEY=
EXCHANGE_RATE_API_KEY=

# ── Optional: Google Sign-In ──────────────────────────────────────────
# Must match VITE_GOOGLE_CLIENT_ID in the frontend .env
GOOGLE_CLIENT_ID=

# ── Optional: Razorpay (Premium upgrade) ──────────────────────────────
# Without these, the Premium button reports that payments aren't configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Optional: tuning ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000

# Not used by the app today — Redis is not required to run it.
# REDIS_URL=redis://localhost:6379
